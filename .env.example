# ───────────── EKA BUILD environment ─────────────
# Copy to .env and fill in. In docker compose these are injected into api/worker/web containers.

NODE_ENV=production
APP_DOMAIN=ekabuild.uz
PUBLIC_URL=https://ekabuild.uz
# Cookie domain shared by ekabuild.uz, app., admin., api.  (leave empty for localhost)
COOKIE_DOMAIN=.ekabuild.uz

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ekabuild
MYSQL_USER=eka
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql://eka:change-me@mysql:3306/ekabuild

# Redis (rate limit, cache, realtime fan-out)
REDIS_URL=redis://redis:6379

# RabbitMQ (event bus → worker)
RABBITMQ_USER=eka
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://eka:change-me@rabbitmq:5672

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=30

# Files: local (shared volume) or s3 (any S3-compatible storage)
STORAGE_DRIVER=local
STORAGE_DIR=/data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ekabuild
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMS: mock (logs code, returns devCode) | eskiz
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# E-IMZO: mock (demo signatures) | eimzo
EIMZO_MODE=mock
# E-IMZO server (dsv-server) used to verify PKCS#7 on the backend
EIMZO_SERVER_URL=http://eimzo-server:8080
# Browser API keys for the local E-IMZO app: "domain:key,domain2:key2"
NEXT_PUBLIC_EIMZO_API_KEYS=

# Cadastre provider: mock | (future: official API)
CADASTRE_PROVIDER=mock

# Web
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_SITE_URL=https://ekabuild.uz

# Seed demo data on first start (true/false)
SEED_DEMO=true
