{
  "name": "ekabuild",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @eka/shared build && pnpm --filter @eka/api build && pnpm --filter @eka/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @eka/api prisma:migrate",
    "db:seed": "pnpm --filter @eka/api db:seed",
    "db:studio": "pnpm --filter @eka/api prisma:studio"
  }
}
