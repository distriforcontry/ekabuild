# Public virtual hosts for ${DOMAIN}: landing (+www), cabinet. (app. alias), admin. → Next.js pool; api. → API pool.
# Every web host also routes /api/* straight to the API pool (same-origin cookies, no CORS).

# ── HTTP: ACME challenges + redirect to HTTPS
server {
  listen 80 default_server;
  server_name ${DOMAIN} www.${DOMAIN} cabinet.${DOMAIN} app.${DOMAIN} admin.${DOMAIN} api.${DOMAIN} _;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { return 301 https://$host$request_uri; }
}

# shared TLS settings
map $host $eka_hsts { default "max-age=63072000; includeSubDomains"; }

# ── www → apex
server {
  listen 443 ssl;
  http2 on;
  server_name www.${DOMAIN};
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  return 301 https://${DOMAIN}$request_uri;
}

# ── landing, cabinet and admin (one Next.js app; middleware maps cabinet./admin. roots)
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN} cabinet.${DOMAIN} app.${DOMAIN} admin.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_session_cache shared:SSL:20m;
  ssl_session_timeout 1d;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  include /etc/nginx/snippets/security-headers.conf;

  limit_conn conn 50;

  # auth endpoints: stricter limit (OTP / login brute force). Prefix (^~) locations: the longest one wins and
  # regex locations are skipped, so API traffic never reaches the static-file rule below.
  location ^~ /api/v1/auth/ {
    limit_req zone=auth burst=10 nodelay;
    proxy_pass http://api_pool;
  }

  # realtime support chat (WebSocket, long-lived)
  location ^~ /api/v1/support/ws {
    proxy_pass http://api_pool;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
  }

  # large uploads stream straight to the API
  location = /api/v1/files {
    limit_req zone=api burst=20 nodelay;
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_pass http://api_pool;
  }

  # never expose Prometheus metrics publicly
  location = /api/v1/metrics { return 404; }
  location = /metrics { return 404; }

  # ^~ : API paths never fall through to the static-file regex below
  location ^~ /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://api_pool;
  }

  # content-hashed Next.js bundles — cache forever
  location ^~ /_next/static/ {
    proxy_pass http://web_pool;
    include /etc/nginx/snippets/static-cache.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # renders, images, fonts, 3D models, HDRIs from /public — not content-hashed, so a long max-age plus
  # stale-while-revalidate (browsers re-check in the background after 7 days)
  location ~* \.(?:webp|avif|jpe?g|png|gif|svg|ico|woff2?|ttf|exr|hdr|glb|gltf)$ {
    proxy_pass http://web_pool;
    include /etc/nginx/snippets/static-cache.conf;
    add_header Cache-Control "public, max-age=604800, stale-while-revalidate=2592000" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  location / {
    proxy_pass http://web_pool;
  }
}

# ── public API host (integrations, mobile apps)
server {
  listen 443 ssl;
  http2 on;
  server_name api.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  include /etc/nginx/snippets/security-headers.conf;

  location /api/v1/support/ws {
    proxy_pass http://api_pool;
    proxy_read_timeout 3600s;
    proxy_buffering off;
  }
  location = /metrics { return 404; }
  location ~ ^/api/v1/auth/ {
    limit_req zone=auth burst=10 nodelay;
    proxy_pass http://api_pool;
  }
  location / {
    limit_req zone=api burst=60 nodelay;
    proxy_request_buffering off;
    proxy_pass http://api_pool;
  }
}
