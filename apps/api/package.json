{
  "name": "@eka/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@eka/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@prisma/client": "6.19.3",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.10.0",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
